# Copie para .env e preencha. O .env NUNCA vai para o git.

# --- Anthropic ---
# Chave da API em https://platform.claude.com -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase ---
# Projeto: tittvjdrtuzsresheore
SUPABASE_URL=https://tittvjdrtuzsresheore.supabase.co

# service_role key: Dashboard -> Project Settings -> API -> service_role
# ATENÇÃO: ignora RLS e dá acesso total ao banco.
# Só no servidor. Nunca no navegador, nunca no git, nunca colada em chat.
SUPABASE_SERVICE_ROLE_KEY=

# Chave pública (segura para o front, protegida por RLS). Opcional aqui.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
